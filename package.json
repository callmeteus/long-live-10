{
    "name": "long-live-10",
    "private": true,
    "version": "0.1.0",
    "description": "Windows 10 Community Support Project",
    "scripts": {
        "build": "cargo build",
        "build:release": "cargo build --release",
        "test": "cargo test",
        "test:vm": "cargo test -p vm-harness",
        "vm:setup": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Setup-Vm.ps1",
        "vm:import": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Setup-Vm.ps1",
        "vm:start": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Start-Vm.ps1",
        "vm:prepare": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Prepare-Guest.ps1",
        "vm:revert": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Revert-Vm.ps1",
        "vm:smoke": "powershell -ExecutionPolicy Bypass -File tools/vm/qemu/Invoke-SmokeTest.ps1",
        "vm:smoke:full": "powershell -ExecutionPolicy Bypass -File tools/vm/qemu/Invoke-FullSmokeTest.ps1",
        "vm:finalize": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Finalize-Vm.ps1",
        "vm:build-prebuilt": "powershell -ExecutionPolicy Bypass -File tools/vm/virtualbox/Build-PrebuiltImage.ps1",
        "eos:suppress-prompts": "powershell -ExecutionPolicy Bypass -File tools/suppress-eos-prompts.ps1",
        "patch:verify": "powershell -ExecutionPolicy Bypass -File tools/patches/cve-2026-96951/motw/patch-cve-2026-96951.ps1 -Mode Verify",
        "patch:apply": "powershell -ExecutionPolicy Bypass -File tools/patches/cve-2026-96951/motw/patch-cve-2026-96951.ps1 -Mode Apply",
        "patch:revert": "powershell -ExecutionPolicy Bypass -File tools/patches/cve-2026-96951/motw/patch-cve-2026-96951.ps1 -Mode Revert",
        "test:ci": "node --test tools/ci/affected.test.mjs",
        "ci:affected": "node tools/ci/affected.mjs",
        "release:build": "cargo run -p release-tools --bin release-build --",
        "validate:catalog": "cargo run --quiet -p catalog-schema --bin catalog-validate -- catalogs && cargo run --quiet -p compatibility-catalog --bin compatibility-validate -- packages/compatibility-catalog/entries",
        "lint": "cargo clippy -- -D warnings",
        "format": "cargo fmt",
        "format:check": "cargo fmt -- --check"
    }
}
