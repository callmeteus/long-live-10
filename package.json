{
    "name": "long-live-10",
    "private": true,
    "version": "0.1.0",
    "description": "Windows 10 Community Support Project",
    "scripts": {
        "build": "cargo build",
        "build:release": "cargo build --release",
        "test": "cargo test",
        "test:vm": "cargo test -p vm-harness",
        "vm:setup": "powershell -ExecutionPolicy Bypass -File tools/vm/qemu/Setup-Vm.ps1",
        "vm:start": "powershell -ExecutionPolicy Bypass -File tools/vm/qemu/Start-Vm.ps1",
        "vm:revert": "powershell -ExecutionPolicy Bypass -File tools/vm/qemu/Revert-Vm.ps1",
        "vm:smoke": "powershell -ExecutionPolicy Bypass -File tools/vm/qemu/Invoke-SmokeTest.ps1",
        "test:ci": "node --test tools/ci/affected.test.mjs",
        "ci:affected": "node tools/ci/affected.mjs",
        "release:build": "cargo run -p release-tools --bin release-build --",
        "validate:catalog": "cargo run --quiet -p catalog-schema --bin catalog-validate -- catalogs && cargo run --quiet -p compatibility-catalog --bin compatibility-validate -- packages/compatibility-catalog/entries",
        "lint": "cargo clippy -- -D warnings",
        "format": "cargo fmt",
        "format:check": "cargo fmt -- --check"
    }
}
