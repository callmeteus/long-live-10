[Unit]
Description=LL10 Windows 10 test VM (QEMU/KVM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/vm
ExecStart=/usr/bin/qemu-system-x86_64 -enable-kvm -m 4096 -smp 2 -cpu host -drive file=/home/server/vm/ll10-22h2-parent.qcow2,format=qcow2 -netdev user,id=net0,hostfwd=tcp:127.0.0.1:55985-:5985,hostfwd=tcp:127.0.0.1:53389-:3389,hostfwd=tcp:127.0.0.1:55990-:55990 -device e1000,netdev=net0 -vnc :0
Restart=always
RestartSec=5
StandardOutput=append:/home/server/vm/qemu-systemd.log
StandardError=append:/home/server/vm/qemu-systemd.log

[Install]
WantedBy=multi-user.target
